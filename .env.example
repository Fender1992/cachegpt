# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ============================================================================
# LLM Provider Configuration (v12.3.0+)
# ============================================================================
# IMPORTANT: Default provider is 'internal' (NOT Anthropic).
# Premium providers (Anthropic/OpenAI) are ONLY used when explicitly requested.
# Presence of ANTHROPIC_API_KEY does NOT change default behavior.

# Core LLM Configuration
LLM_PROVIDER=internal                        # Default: internal | free | anthropic | openai
LLM_ALLOW_OVERRIDE=true                      # Allow x-llm-provider header override
LLM_LOG_PROVIDER_SELECTION=true              # Log provider selection decisions

# Internal/Native LLM Configuration (First Priority)
INTERNAL_LLM_ENABLED=true                    # Enable internal LLM provider
INTERNAL_LLM_URL=http://localhost:8080       # Base URL for internal LLM
INTERNAL_LLM_API_KEY=                        # Optional: API key for internal LLM
INTERNAL_LLM_MODEL=default                   # Model name for internal LLM
INTERNAL_LLM_HEALTH_URL=http://localhost:8080/health  # Health check endpoint
INTERNAL_LLM_HEALTH_INTERVAL=30000           # Health check cache duration (ms)
INTERNAL_LLM_TIMEOUT=30000                   # Request timeout (ms)

# Fallback Behavior
LLM_ALLOW_FALLBACK_TO_FREE=true              # Allow fallback to Groq/OpenRouter/HuggingFace
LLM_ALLOW_FALLBACK_TO_PREMIUM=false          # Allow fallback to Anthropic/OpenAI
LLM_HARD_FAIL_ON_INTERNAL_DOWN=true          # Return 503 if internal down (no fallback)

# Free Provider API Keys (Second Priority)
GROQ_API_KEY=your_groq_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here
HUGGINGFACE_API_KEY=hf_your_huggingface_api_key_here

# Premium Provider API Keys (ONLY used when explicitly requested)
# These keys do NOT trigger automatic usage. They are only used when:
# 1. x-llm-provider header explicitly requests them
# 2. User has stored their own API key in the database
# 3. LLM_ALLOW_FALLBACK_TO_PREMIUM=true AND all other providers fail
ANTHROPIC_API_KEY=sk-ant-your_anthropic_api_key_here
OPENAI_API_KEY=sk-proj-your_openai_api_key_here

# Security
JWT_SECRET=your_jwt_secret_here_use_a_secure_random_string

# Sentry Error Monitoring (optional)
NEXT_PUBLIC_SENTRY_DSN=your_sentry_dsn_here
SENTRY_DSN=your_sentry_dsn_here
ENABLE_SENTRY_DEV=false

# Rate Limiting
RATE_LIMIT_REQUESTS_PER_MINUTE=100
RATE_LIMIT_REQUESTS_PER_HOUR=1000

# Environment
ENVIRONMENT=development
LOG_LEVEL=INFO

# Feature Flags
# Set to 'true' to enable enterprise mode where users can provide their own API keys
FEATURE_ENTERPRISE_USER_KEYS=false

# Additional LLM Provider Keys (server-side)
GOOGLE_AI_API_KEY=your_google_ai_key_here
PERPLEXITY_API_KEY=your_perplexity_key_here

# Free Provider API Keys (for server-side rotation)
GROQ_API_KEY=your_groq_api_key_here
TOGETHER_API_KEY=your_together_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Cron Secret (for scheduled jobs)
CRON_SECRET=your_cron_secret_here_use_a_secure_random_string

# Production URL
NEXT_PUBLIC_SITE_URL=https://cachegpt.app

# News API Keys (for real-time news context)
# NewsAPI.org - 100 requests/day free tier
NEWS_API_KEY=your_newsapi_key_here
# NewsData.io - 200 requests/day free tier
NEWSDATA_API_KEY=your_newsdata_key_here
# GNews API - 100 requests/day free tier
GNEWS_API_KEY=your_gnews_api_key_here