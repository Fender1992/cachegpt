# ============================================================
# OpenClaw Server — Environment Configuration
# Copy to .env and fill in your values:
#   cp .env.example .env
# ============================================================

# === LLM Provider ===
ANTHROPIC_API_KEY=sk-ant-api03-YOUR_KEY_HERE

# === CacheGPT ===
CACHEGPT_API_URL=https://cachegpt.app/api
CACHEGPT_API_KEY=YOUR_CACHEGPT_KEY_HERE

# === Telegram ===
TELEGRAM_BOT_TOKEN=YOUR_BOT_TOKEN_HERE
TELEGRAM_CHAT_ID=YOUR_CHAT_ID_HERE

# === Timezone ===
TZ=America/Chicago

# === Security ===
# Generate with: openssl rand -base64 48
OPENCLAW_GATEWAY_PASSWORD=GENERATE_WITH_openssl_rand_-base64_48
